# ── Server ────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# Required. The app refuses to start without it.
MONGODB_URI=mongodb://localhost:27017/aquawater

# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string

# Comma-separated list of allowed browser origins.
#
# Normally leave this EMPTY: the client is served from the same origin as the
# API, so no cross-origin request is made and CORS never comes into play. Only
# set it if some other site must call this API directly.
CORS_ORIGINS=

# ── Telegram Bot ──────────────────────────────────────────────────────────
# From @BotFather. Without this the bot is disabled entirely.
TELEGRAM_BOT_TOKEN=
# Group/channel that receives new-order cards. Send /start to the bot in that
# chat and it replies with the id (groups start with -100...).
TELEGRAM_ADMIN_CHAT_ID=
# Public site URL used in the bot's inline buttons. Set this to your own
# Vercel domain after the first deploy (e.g. https://aquawater.vercel.app).
WEBAPP_URL=

# Set to 'true' on serverless hosts (Vercel), where long-polling cannot run.
# Vercel is serverless, so long-polling cannot run there — use webhook mode.
# After deploying, register it once (see README step 4).
TELEGRAM_USE_WEBHOOK=true
TELEGRAM_WEBHOOK_SECRET=

# Set to 'false' to process queued updates from before the server started.
TELEGRAM_SKIP_BACKLOG=true

# ── Eskiz SMS (OTP delivery) ──────────────────────────────────────────────
# Leave blank to mock SMS — the code is printed to the server log instead.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# ── OTP ───────────────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN=60
OTP_LENGTH=6

# Require SMS verification before /register succeeds. The current web UI has no
# OTP step, so enabling this without updating the frontend blocks all sign-ups.
REQUIRE_PHONE_VERIFICATION=false

# Accept the universal code 123456 in local development only.
ALLOW_DEV_OTP=false

# ── Google Sheets mirror (optional) ───────────────────────────────────────
# Leave blank to skip syncing. Share both sheets with the service account email.
# Optional. Leave all of these empty and the app simply does not sync — every
# figure still lives in the admin panel and the CSV export.
#
# The id is the long string in the sheet's own URL:
#   docs.google.com/spreadsheets/d/<THIS PART>/edit
#
# Both files must be shared with GOOGLE_SERVICE_ACCOUNT_EMAIL as an Editor,
# otherwise every write is refused. The "Products" and "Orders" tabs are
# created automatically on the first sync.
GOOGLE_SHEET_ID=
GOOGLE_PRODUCTS_SHEET_ID=
GOOGLE_ORDERS_SHEET_ID=

# From the service-account JSON: "client_email" and "private_key".
# Paste the key exactly as it appears, \n sequences and all.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ── Seed script ───────────────────────────────────────────────────────────
# `npm run seed` wipes users and products. Must be 'true' to run.
ALLOW_DESTRUCTIVE_SEED=false
