# Odatda BU FAYL KERAK EMAS.
#
# Frontend va backend bitta Vercel loyihasida, bitta domenda ishlaydi,
# shuning uchun client standart holda nisbiy `/api` manzilidan foydalanadi —
# hech qanday sozlash talab qilinmaydi.
#
# Bu o'zgaruvchi faqat bitta holatda kerak: `npm run dev` bilan lokal
# ishlaganda, frontend :5173 da, backend esa :5001 da alohida turadi.
# VITE_API_BASE_URL=http://localhost:5001
